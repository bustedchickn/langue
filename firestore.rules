rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Mutations go through the authenticated game API, which enforces transitions.
    match /profiles/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
    }

    match /friendships/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
    }

    match /invitations/{id} {
      allow read: if signedIn() &&
        (request.auth.uid == resource.data.to || request.auth.uid == resource.data.from);
    }
  }
}
