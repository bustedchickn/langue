rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Mutations go through the authenticated game API, which enforces transitions.
    match /profiles/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
    }

    match /friendships/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
    }

    match /invitations/{id} {
      allow read: if signedIn() &&
        (request.auth.uid == resource.data.to || request.auth.uid == resource.data.from);
    }

    match /vocabularyHubs/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.ownerUid == uid;
    }

    match /vocabularySets/{setId} {
      allow read, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.id == setId && request.resource.data.words is list &&
        request.resource.data.words.size() <= 200;
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.id == setId && request.resource.data.words is list &&
        request.resource.data.words.size() <= 200;
    }
  }
}
