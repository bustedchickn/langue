# Local Firebase emulators. For production, set the same real project ID on both sides.
VITE_USE_EMULATORS=true
# Optional in Vite development with the emulators.
# VITE_QUICK_GUEST=true
VITE_FIREBASE_PROJECT_ID=demo-idle
FIREBASE_PROJECT_ID=demo-idle
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Public Firebase web app configuration. Required for a real Firebase project.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_APP_ID=

# The Vite proxy expects port 2567 during development.
# PORT=2567
# HOST=0.0.0.0
# VITE_GAME_SERVER=
# CLIENT_ORIGIN=
INVITE_SECONDS=300
# MATCH_RECIPROCAL_PRIORITY_MS=10000

# Local development may use STUN alone. Production needs a public TURN service:
# see deploy/turn/README.md. These settings belong only on the game server.
# STUN_URLS=stun:stun.l.google.com:19302
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp,turns:turn.example.com:443?transport=tcp
# Same secret as coturn; generate 32 random bytes (for example openssl rand -hex 32).
# Never use a VITE_ prefix for TURN_SECRET or publish it in the browser build.
# TURN_SECRET=
# TURN_CREDENTIAL_TTL_SECONDS=3600
# Explicit degraded/test-only production override; restricted networks may fail.
# VOICE_ALLOW_STUN_ONLY=true
