{
  "name": "langue",
  "version": "1.0.0",
  "description": "Ihack 2026 language cooperation game",
  "scripts": {
    "dev": "concurrently -k npm:dev:client npm:dev:server",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx --env-file-if-exists=.env server/index.ts",
    "build:cloud": "tsc --noEmit && vite build --mode cloud --outDir dist-cloud",
    "start:cloud": "tsx --env-file=.env.cloud server/index.ts",
    "smoke": "tsx scripts/smoke.mjs",
    "emulators": "npx --yes firebase-tools@14.17.0 emulators:start --project demo-idle --only auth,firestore",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "tsx scripts/browser-smoke.ts",
    "dev:players": "node scripts/dev-players.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bustedchickn/langue.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/bustedchickn/langue/issues"
  },
  "homepage": "https://github.com/bustedchickn/langue#readme",
  "dependencies": {
    "@colyseus/core": "^0.16.26",
    "@colyseus/schema": "^3.0.76",
    "@colyseus/ws-transport": "^0.16.5",
    "colyseus.js": "^0.16.22",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "firebase": "^13.3.0",
    "firebase-admin": "^14.5.1",
    "phaser": "^4.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^9.2.5",
    "playwright": "^1.65.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
